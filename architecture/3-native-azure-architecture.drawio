  <diagram id="3-native-azure-architecture" name="Fully native Azure pipeline">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="690" math="0" shadow="0" background="#FFFFFF">
